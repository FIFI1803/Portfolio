# Production origin — used for canonical, Open Graph, sitemap and JSON-LD URLs.
# Must be absolute and without a trailing slash. Falls back to
# https://filipgalach.com when unset (see scripts/site.mjs).
VITE_SITE_URL=https://filipgalach.com

# Supabase — powers the contact form, /admin, and `npm run sync:content`.
# The public site renders from the committed snapshot without these, but the
# contact form and admin panel are disabled until they are set.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
